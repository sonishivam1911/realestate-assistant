ARG CMA_SOURCE=.
FROM node:20-alpine AS build
WORKDIR /app
COPY ${CMA_SOURCE}/frontend/package.json ${CMA_SOURCE}/frontend/package-lock.json* ./
RUN npm ci
COPY ${CMA_SOURCE}/frontend/ .
ARG BACKEND_URL=http://cma_api:8080
ENV BACKEND_URL=$BACKEND_URL
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ARG BACKEND_URL=http://cma_api:8080
ENV BACKEND_URL=$BACKEND_URL
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["npm", "start"]
