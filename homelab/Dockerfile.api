# Build from realestate-assistant root:
#   docker build -f homelab/Dockerfile.api -t cma-api .
# Build from homelab-contabo root (after rsync to sources/cma-assistant):
#   docker build -f images/cma-assistant/Dockerfile.api --build-arg CMA_SOURCE=./sources/cma-assistant -t cma-api .
ARG CMA_SOURCE=.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY ${CMA_SOURCE}/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ${CMA_SOURCE}/api api
COPY ${CMA_SOURCE}/db db
COPY ${CMA_SOURCE}/nodes nodes
COPY ${CMA_SOURCE}/prompts prompts
COPY ${CMA_SOURCE}/services services
COPY ${CMA_SOURCE}/workflow workflow

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
