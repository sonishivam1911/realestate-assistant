# OpenRouter (required for CMA v2)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing — Chinese frontier (no Sonar)
CMA_MODEL_RESEARCH=deepseek/deepseek-v4-flash
CMA_MODEL_SYNTHESIS=deepseek/deepseek-v4-pro
CMA_MODEL_INTAKE=deepseek/deepseek-v4-flash
# Optional: Kimi K2 for tool orchestration only (~6x pricier, still needs Exa search)
# CMA_MODEL_ORCHESTRATOR=moonshotai/kimi-k2

CMA_WEB_SEARCH_ENGINE=exa
CMA_DEFAULT_RADIUS_MILES=5
CMA_TIMEFRAME_MONTHS=3

# Postgres — Contabo homelab (SSH tunnel via ./start_dev.sh)
CONTABO_TUNNEL=true
CONTABO_LOCAL_PG_PORT=5433
# Auto-reads ../homelab-contabo/homelab.env for SERVER_IP / SSH_KEY
# POSTGRES_PASSWORD = homelab-contabo/.env POSTGRES_PASSWORD
POSTGRES_URI=
POSTGRES_URI_CONTABO=postgresql://postgres:PASSWORD@127.0.0.1:5433/postgres
SUPABASE_STUDIO_URL=https://supabase.minaki.me

AUTO_MIGRATE=true
LLM_REQUEST_TIMEOUT=240

# Email — same vars as real-time-minaki-poc (SendGrid or SMTP)
EMAIL_METHOD=smtp
# EMAIL_METHOD=sendgrid
# SENDGRID_API_KEY=
FROM_EMAIL=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
COMPANY_NAME=CMA Assistant
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Legacy Groq (old streamlit workflow only)
GROQ_API_KEY=
